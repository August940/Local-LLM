# Gateway settings (copy to .env, never commit the real file)
BACKEND=runpod                 # runpod | comfyui
RUNPOD_ENDPOINT_ID=
RUNPOD_API_KEY=
# COMFY_URL=http://127.0.0.1:8188   # only for BACKEND=comfyui
WAN_MODEL=5b                   # 5b (cheaper, 24 GB GPU) | 14b (better, 48 GB+ GPU)
GENERATION_API_KEY=            # shared secret the website sends as "Authorization: Bearer ..."
# WORKFLOW_T2I=my_image_workflow.json   # optional: use your own exported workflows
# WORKFLOW_I2I=my_img2img_workflow.json
