# --- Supabase (Project settings -> API) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Server only. Used by the queue worker to write results and sign Explore URLs.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public URL of this site (used for auth redirects and provider callbacks)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Generation backend ---
# mock     = no GPU, returns a styled placeholder so UI + queue can be tested
# api      = serverless generation backend (wraps the ComfyUI / Wan 2.2 workflow)
# comfyui  = talk to a ComfyUI server directly (RunPod, Vast.ai, own cloud GPU)
GENERATION_PROVIDER=mock
GENERATION_API_URL=https://your-generation-backend
GENERATION_API_KEY=
COMFYUI_URL=https://your-comfyui-endpoint
# Optional bearer token if your ComfyUI endpoint sits behind auth
COMFYUI_API_KEY=
# How many jobs may run on the GPU at the same time
QUEUE_CONCURRENCY=1
# Shared secret for calling /api/queue/tick from a cron job
QUEUE_CRON_SECRET=change-me

# --- Billing ---
# Leave empty to use demo billing (plan buttons switch plans without payment, dev only)
STRIPE_SECRET_KEY=
STRIPE_PRICE_CREATOR=
STRIPE_PRICE_STUDIO=
STRIPE_WEBHOOK_SECRET=
ALLOW_DEMO_BILLING=true

# --- Chat (optional) ---
# OpenAI-compatible chat endpoint, e.g. Ollama: http://localhost:11434/v1
CHAT_API_URL=
CHAT_API_KEY=
CHAT_MODEL=llama3.1
